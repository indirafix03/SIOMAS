# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siomas

# SQLAlchemy
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:@127.0.0.1:3306/siomas?charset=utf8mb4
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Flask & JWT
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# File Uploads
UPLOAD_FOLDER=E:\siomas-flask\uploads
MAX_CONTENT_LENGTH_MB=16

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_DEFAULT_SENDER="SIOMAS Notification <no-reply@siomas.ac.id>"
